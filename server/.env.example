# Server
PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-admin-token
JWT_SECRET=replace-with-a-long-random-jwt-secret
DB_PATH=./data/sentinel.db

# Monitored public account and keywords
X_ACCOUNT=thsottiaux
KEYWORDS=reset,重置
POLL_INTERVAL_MIN=15
POLL_JITTER=0.25

# Data source
# mock is for local UI development; crawler requires your own local cookie file.
FETCH_MODE=mock
USE_CRAWLER=0
X_COOKIES_FILE=./cookies.json

# Optional explicit proxy URL. Leave empty when the machine already uses a system proxy.
X_PROXY=

# Optional proxy toggle command. Leave empty for system proxy mode.
CLASHCTL_COMMAND=
CLASHCTL_SHELL=/bin/bash

# Email SMTP. These values can also be configured in admin/index.html.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional WeChat settings; not required by the web version.
WX_APPID=
WX_APPSECRET=
WX_SUBSCRIBE_TMPL_IDS=
